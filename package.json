{
  "name": "sales-claw-ts",
  "version": "2.0.0",
  "description": "Automated B2B company outreach via web contact forms — TypeScript port (Electron main + dashboard server)",
  "main": "dist-ts/electron-main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild-copy.cjs",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "node scripts/clean-build.cjs",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "start": "npm run build && electron .",
    "start:fast": "electron .",
    "dashboard": "npm run build && node dist-ts/src/dashboard-server.js",
    "dashboard:preview": "node scripts/preview-dashboard.cjs",
    "dashboard:restart": "node scripts/restart-dashboard.cjs",
    "lint": "eslint src/ scripts/ tests/ electron-main.ts --ext .ts,.cjs,.js",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "npm run build && node tests/redact.test.cjs && node tests/settings-cache.test.cjs && node tests/mcp-config-helpers.test.cjs && node tests/spawn-env-sanitizer.test.cjs && node tests/analysis-cache.test.cjs && node tests/playwright-wrapper-syntax.test.cjs && node tests/dashboard-runtime.test.cjs",
    "test": "npm run test:unit && playwright test",
    "verify:unit": "npm run test:unit",
    "verify:release": "npm run typecheck && npm run test:unit && node scripts/verify-release-readiness.cjs",
    "verify:dist": "node scripts/verify-release-readiness.cjs --dist",
    "verify:installed": "node scripts/verify-release-readiness.cjs --installed",
    "verify:github": "node scripts/verify-release-readiness.cjs --github",
    "install:win": "powershell -ExecutionPolicy Bypass -File scripts/install-latest-win.ps1",
    "preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preflight-ai.ps1",
    "clean:workspace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1",
    "predist": "npm run verify:release",
    "postdist": "npm run verify:dist",
    "dist": "electron-builder --win --mac --linux",
    "predist:win": "npm run verify:release",
    "dist:win": "electron-builder --win",
    "postdist:win": "npm run verify:dist",
    "predist:mac": "npm run verify:release",
    "dist:mac": "electron-builder --mac",
    "predist:linux": "npm run verify:release",
    "dist:linux": "electron-builder --linux",
    "setup": "node -e \"const fs=require('fs');if(!fs.existsSync('data/settings.json'))fs.copyFileSync('data/sample-settings.json','data/settings.json');console.log('data/settings.json ready');\""
  },
  "keywords": [
    "outreach",
    "automation",
    "playwright",
    "claude-code",
    "codex",
    "gemini",
    "b2b",
    "sales",
    "typescript",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@playwright/mcp": "^0.0.70",
    "electron-updater": "^6.8.3",
    "fs-extra": "^10.1.0",
    "node-pty": "^1.1.0",
    "npm": "^10.9.8",
    "playwright": "^1.58.2",
    "universalify": "^2.0.1",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-promise": "^7.2.1",
    "typescript": "^5.7.3"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
