{
  "name": "sales-claw-ts",
  "version": "2.1.11",
  "description": "Automated B2B company outreach via web contact forms — TypeScript port (Electron main + dashboard server)",
  "main": "dist-ts/electron-main.js",
  "bin": {
    "sales-claw-form-mcp": "bin/sales-claw-form-mcp.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/bundle-client-scripts.ts && tsx scripts/postbuild-copy.ts",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "tsx scripts/clean-build.ts",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "start": "npm run build && electron .",
    "start:fast": "electron .",
    "dashboard": "npm run build && node dist-ts/src/dashboard-server.js",
    "dashboard:preview": "tsx scripts/preview-dashboard.ts",
    "dashboard:restart": "tsx scripts/restart-dashboard.ts",
    "lint": "eslint src/ scripts/ tests/ electron-main.ts --ext .ts,.cjs,.js",
    "lint:fix": "npm run lint -- --fix",
    "debt:metrics": "tsx scripts/debt-metrics.ts",
    "debt:check": "tsx scripts/debt-metrics.ts --check",
    "analyze:dead": "knip",
    "analyze:deps": "depcheck",
    "analyze:exports": "ts-prune -p tsconfig.json",
    "analyze:circular": "madge --circular --extensions ts src electron-main.ts",
    "analyze:dup": "jscpd src --min-lines 8 --reporters console --silent",
    "analyze": "npm run debt:metrics && npm run analyze:dead && npm run analyze:circular && npm run analyze:dup",
    "test:unit": "npm run build && node tests/run-unit.cjs",
    "test:unit:nobuild": "node tests/run-unit.cjs",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=json-summary --reporter=lcov node tests/run-unit.cjs",
    "test:e2e": "npm run build && node tests/electron-real-form.test.cjs && node tests/real-managed-home-purge.test.cjs",
    "test:e2e:ci": "npm run build && playwright test && node tests/electron-real-form.test.cjs",
    "test": "npm run test:unit && playwright test",
    "verify:unit": "npm run test:unit",
    "verify:release": "npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts && npm run test:unit && tsx scripts/verify-release-readiness.ts",
    "verify:dist": "tsx scripts/verify-release-readiness.ts --dist",
    "verify:installed": "tsx scripts/verify-release-readiness.ts --installed",
    "verify:github": "tsx scripts/verify-release-readiness.ts --github",
    "install:win": "powershell -ExecutionPolicy Bypass -File scripts/install-latest-win.ps1",
    "preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preflight-ai.ps1",
    "clean:workspace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1",
    "prefetch:bundles": "tsx scripts/prefetch-bundles.ts",
    "predist": "npm run verify:release && npm run prefetch:bundles",
    "postdist": "npm run verify:dist",
    "dist": "electron-builder --win --mac --linux",
    "predist:win": "npm run verify:release && npm run prefetch:bundles",
    "dist:win": "electron-builder --win",
    "postdist:win": "npm run verify:dist",
    "predist:mac": "npm run verify:release && npm run prefetch:bundles",
    "dist:mac": "electron-builder --mac",
    "predist:linux": "npm run verify:release && npm run prefetch:bundles",
    "dist:linux": "electron-builder --linux",
    "setup": "node -e \"const fs=require('fs');if(!fs.existsSync('data/settings.json'))fs.copyFileSync('data/sample-settings.json','data/settings.json');console.log('data/settings.json ready');\""
  },
  "keywords": [
    "outreach",
    "automation",
    "playwright",
    "claude-code",
    "codex",
    "gemini",
    "b2b",
    "sales",
    "typescript",
    "electron"
  ],
  "author": "Sales Claw contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joseikininsight-hue/sales-claw-ts.git"
  },
  "bugs": {
    "url": "https://github.com/joseikininsight-hue/sales-claw-ts/issues"
  },
  "homepage": "https://github.com/joseikininsight-hue/sales-claw-ts#readme",
  "dependencies": {
    "@playwright/mcp": "^0.0.70",
    "electron-updater": "^6.8.3",
    "fs-extra": "^10.1.0",
    "node-pty": "^1.1.0",
    "npm": "^11.14.1",
    "playwright": "^1.58.2",
    "universalify": "^2.0.1",
    "ws": "^8.20.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@emnapi/wasi-threads": "^1.2.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "c8": "^11.0.0",
    "depcheck": "^1.4.7",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-promise": "^7.2.1",
    "jscpd": "^5.0.7",
    "knip": "^6.16.1",
    "madge": "^8.0.0",
    "ts-prune": "^0.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-unicode11": "^0.6.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
