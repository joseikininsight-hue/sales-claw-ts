data/*.lock

# Electron runtime stdout/stderr captures (dev only)
/electron-*.out
/electron-*.err

# Screenshots (user-generated)
screenshots/

# AI test artifacts in repo root (block — they belong in screenshots/)
# 過去のセッションで `awaiting-tab-with-mjs.png` などがルートに散らばった
# ことがあるため、ルート直下の画像は明示的に除外する。
# `assets/`, `sample/`, `screenshots/`, `app/`, `public/` 等の配下は対象外。
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.bmp

# Temp PowerShell / shell scripts created during AI debugging
.tmp-*.ps1
.tmp-*.sh
.tmp-*.cjs
.tmp-*.js
/.tmp-*

# User's target list (contains company data)
*.xlsx
data/*.csv
!data/sample-targets.csv

# Playwright
.playwright-mcp/

# Test artifacts (generated)
playwright-report/
playwright-results.xml
test-results/

# Claude Code project config
# Include settings and routing config, exclude user sessions
.claude/subagents/
.claude/conversations/
.claude/*.session
.claude/worktrees/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.*

# Archive (deprecated files)
archive/

# PDF documents (may contain proprietary info)
*.pdf

# Temp
tmp/
temp/
.sales-claw-work/

# Generated by setup.bat / setup.sh (contains absolute path, user-specific)
launch-silent.vbs
launch.sh
assets/名称未設定のデザイン.png

# Claude Code user-local config (may contain machine-specific permissions/credentials)
.claude/settings.local.json

# Electron build output
dist/
dist-released/
.next/

# Electron dev
.webpack/
.electron-userdata/
.aidesigner/*
!.aidesigner/.gitkeep

# Local agent/MCP config (machine-specific)
.agents/
.mcp.json

# AI run metrics (operational data)
data/ai-run-metrics.jsonl

# Internal evaluation notes & requirement docs (may contain PII / business strategy)
docs/blog-evaluation-*.md
docs/message-quality-improvement-requirements.md

# Git history cleanup workspace (PII replacement rules, runbook — do not commit)
.git-history-cleanup/

# ─── TypeScript build outputs (compiled in-place) ─────────────────────
# Source is authored in .ts; tsc emits .js + .js.map next to source.
# Track only .ts/.cjs; .js outputs are build artifacts.
/electron-main.js
/electron-main.js.map
src/**/*.js
src/**/*.js.map
!src/ui/client-scripts/*.js
# Client scripts are served verbatim by the dashboard; if any are authored as .js they should be tracked.
.tsbuildinfo
*.tsbuildinfo
dist-ts/
out/

